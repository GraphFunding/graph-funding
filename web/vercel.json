{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.graphfunding.app" }], "destination": "https://graphfunding.app/$1", "permanent": true }
  ],
  "rewrites": [{ "source": "/badge/:id", "destination": "/badge.json" }],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/badge.json", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] }
  ]
}
